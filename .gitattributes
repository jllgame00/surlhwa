* text=auto

*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
# These accepted packages predate the LF policy; their exact CRLF bytes own
# existing save content hashes and continuation pins. Preserve them on checkout.
Production/Content/Campaign/act1.json text eol=crlf
Production/Content/Campaign/act2.json text eol=crlf
*.md text eol=lf
*.txt text eol=lf

*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.psd binary

*.wav binary
*.mp3 binary
*.ogg binary

*.fbx binary
*.ttf binary
*.otf binary
