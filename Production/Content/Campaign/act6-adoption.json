    },
    {
      "id": "text_rc1_0051",
      "value": "기억하던 맛을 이렇게 다시 만나네요.",
      "sourceText": "기억하던 맛을 이렇게 다시 만나네요.",
      "sourceId": "SRC-RC1-0051",
      "sourceHash": "be8e5695d74316db7a179a644f1ae669e18af79ccb19983609ecb683382f1b98",
